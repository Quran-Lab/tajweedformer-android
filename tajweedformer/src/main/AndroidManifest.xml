<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- model downloads (ModelStore), the unmetered-network check before NPU downloads, and the portal
         link (config, telemetry, issues, recitation sharing) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- model.listen() captures the microphone and asks the learner for this permission itself. An app that never
         calls listen() (it pushes its own audio) can remove it: <uses-permission ... tools:node="remove" /> -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <!-- shows only the system's RECORD_AUDIO dialog for model.listen(), over the app -->
        <activity
            android:name="ai.quranlab.tajweedformer.MicrophonePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
